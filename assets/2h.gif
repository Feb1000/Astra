<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 280" width="100%" height="100%">
  <defs>
    <linearGradient id="g2h" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#854d0e" />
      <stop offset="50%" stop-color="#eab308" />
      <stop offset="100%" stop-color="#0f172a" />
    </linearGradient>
    <filter id="glow2h">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#eab308" flood-opacity="0.6"/>
    </filter>
  </defs>
  <rect width="100%" height="100%" rx="16" fill="url(#g2h)"/>
  <rect x="10" y="10" width="480" height="260" rx="12" fill="none" stroke="#eab308" stroke-width="2" stroke-opacity="0.5"/>
  
  <g text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif">
    <rect x="140" y="30" width="220" height="28" rx="14" fill="#eab308" fill-opacity="0.25"/>
    <text x="250" y="49" font-size="12" font-weight="800" fill="#fef08a" letter-spacing="2">⚠️ 2 HOUR MILESTONE</text>
    
    <text x="250" y="135" font-size="75" font-weight="900" fill="#ffffff" filter="url(#glow2h)" letter-spacing="3">2 HOURS!</text>

    <text x="250" y="190" font-size="18" font-weight="800" fill="#fef9c3" letter-spacing="1">FULL MOVIE LENGTH PROCRASTINATION</text>
    <text x="250" y="225" font-size="14" font-weight="600" fill="#cbd5e1">Your spine is turning into a pretzel.</text>
  </g>
</svg>
